# =============================================================================
# CMPDI AI Reporting Platform — environment configuration
# Copy this file to `.env` (repo root or backend/) and adjust values.
# NEVER commit a real .env file.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Option 1: single connection string (takes precedence when set).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Option 2: discrete variables (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmpdi_reporting
DB_USER=cmpdi_user
DB_PASSWORD=CHANGE_ME

# --- AI / LLM providers ---
# Optional. The application must start without any AI credentials.
# AI features are implemented in later steps and stay disabled until then.
LLM_PROVIDER=
LLM_API_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

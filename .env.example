# =============================================================================
# CMPDI AI Reporting Platform — environment configuration
# Copy this file to `.env` (repo root or backend/) and adjust values.
# NEVER commit a real .env file.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Option 1: single connection string (takes precedence when set).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=
# Option 2: discrete variables (used when DATABASE_URL is empty).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmpdi_reporting
DB_USER=cmpdi_user
DB_PASSWORD=CHANGE_ME

# --- AI / LLM providers ---
# Optional. The application must start without any AI credentials.
# AI features are implemented in later steps and stay disabled until then.
LLM_PROVIDER=
LLM_API_KEY=

# --- Document storage (Step 3) ---
# Local directory for uploaded originals (dev). Swap for object storage later.
DOCUMENT_STORAGE_PATH=./storage/documents
# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=25

# --- OCR (Step 5) ---
# Boxes/mean below this confidence are flagged review_required (never auto-corrected).
OCR_CONFIDENCE_THRESHOLD=0.70
# Wall-clock cap per OCR call in seconds (engine-hang protection).
OCR_TIMEOUT_SECONDS=120
# Decompression-bomb guardrail: max pixels per image before OCR.
OCR_MAX_IMAGE_PIXELS=40000000
# Render zoom for scanned PDF pages before OCR (~2.0 ≈ 144 dpi).
PDF_OCR_ZOOM=2.0

# --- Semantic embeddings (Step 9) ---
# Bounded safeguards (provider/model are code-level defaults; local fastembed).
EMBEDDING_MAX_INPUT_CHARS=4000
EMBEDDING_MAX_BATCH_SIZE=32
EMBEDDING_MAX_UNITS_PER_DOCUMENT=500
EMBEDDING_TIMEOUT_SECONDS=120

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# CMPDI AI Reporting Platform — environment configuration
# Copy this file to `.env` (repo root or backend/) and adjust values.
# NEVER commit a real .env file.
# =============================================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=true

# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# NOT required for Step 1: the API starts without a database connection.
DATABASE_URL=postgresql://cmpdi_user:CHANGE_ME@localhost:5432/cmpdi_reporting

# --- AI / LLM providers ---
# Optional. The application must start without any AI credentials.
# AI features are implemented in later steps and stay disabled until then.
LLM_PROVIDER=
LLM_API_KEY=

# --- CORS ---
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

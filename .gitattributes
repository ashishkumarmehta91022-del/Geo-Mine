# Normalize line endings across platforms (avoid CRLF/LF churn).
* text=auto

# Windows scripts may keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets (sample documents will land in data/ in later steps).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.docx binary
